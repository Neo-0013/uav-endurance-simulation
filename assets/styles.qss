QMainWindow, QWidget { background-color:#0d1117; color:#e6edf3; font-family:"Segoe UI",Arial,sans-serif; font-size:12px; }
#sidebar { background-color:#161b22; border-right:1px solid #21262d; min-width:190px; max-width:190px; }
#app_title { color:#58a6ff; font-size:11px; font-weight:bold; padding:16px 12px 2px 16px; letter-spacing:2px; }
#app_subtitle { color:#6e7681; font-size:9px; padding:0 12px 16px 16px; }
QPushButton#nav_btn { background:transparent; color:#8b949e; border:none; text-align:left; padding:12px 16px; font-size:12px; border-left:3px solid transparent; }
QPushButton#nav_btn:hover { background:#21262d; color:#e6edf3; }
QPushButton#nav_btn[active="true"] { background:#1c2128; color:#58a6ff; border-left:3px solid #58a6ff; font-weight:bold; }
#sidebar_footer { color:#6e7681; font-size:9px; padding:8px 16px; border-top:1px solid #21262d; }
QFrame#card { background:#161b22; border:1px solid #21262d; border-radius:8px; }
QLabel#card_title { color:#58a6ff; font-size:11px; font-weight:bold; letter-spacing:1px; }
QLabel#value_big { color:#3fb950; font-size:20px; font-weight:bold; font-family:"Consolas",monospace; }
QLabel#value_med { color:#3fb950; font-size:13px; font-weight:bold; font-family:"Consolas",monospace; }
QLabel#unit_lbl { color:#6e7681; font-size:10px; }
QLabel#section_title { color:#58a6ff; font-size:11px; font-weight:bold; letter-spacing:1px; }
QLabel#param_label { color:#8b949e; font-size:11px; }
QSlider::groove:horizontal { height:4px; background:#21262d; border-radius:2px; }
QSlider::handle:horizontal { background:#58a6ff; border:none; width:14px; height:14px; margin:-5px 0; border-radius:7px; }
QSlider::sub-page:horizontal { background:#1f6feb; border-radius:2px; }
QPushButton#primary_btn { background:#1f6feb; color:#fff; border:none; border-radius:6px; padding:9px 18px; font-size:12px; font-weight:bold; }
QPushButton#primary_btn:hover { background:#388bfd; }
QPushButton#primary_btn:pressed { background:#1158c7; }
QPushButton#success_btn { background:#238636; color:#fff; border:none; border-radius:6px; padding:9px 18px; font-size:12px; font-weight:bold; }
QPushButton#success_btn:hover { background:#2ea043; }
QPushButton#danger_btn { background:#b91c1c; color:#fff; border:none; border-radius:6px; padding:9px 18px; font-size:12px; font-weight:bold; }
QPushButton#danger_btn:hover { background:#dc2626; }
QPushButton#mode_btn { background:#21262d; color:#8b949e; border:1px solid #30363d; border-radius:4px; padding:5px 12px; font-size:11px; }
QPushButton#mode_btn[active="true"] { background:#1f6feb; color:#fff; border-color:#388bfd; }
QPushButton#mode_btn:hover { background:#2d333b; }
QComboBox { background:#21262d; color:#e6edf3; border:1px solid #30363d; border-radius:4px; padding:5px 10px; }
QComboBox QAbstractItemView { background:#161b22; color:#e6edf3; selection-background-color:#1f6feb; }
QScrollBar:vertical { background:#0d1117; width:6px; border-radius:3px; }
QScrollBar::handle:vertical { background:#30363d; border-radius:3px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QGroupBox { border:1px solid #21262d; border-radius:6px; margin-top:8px; color:#58a6ff; font-size:10px; font-weight:bold; letter-spacing:1px; }
QGroupBox::title { subcontrol-origin:margin; subcontrol-position:top left; padding:0 6px; background:#0d1117; }
QFrame#hud_box { background:#0d1117; border:1px solid #21262d; border-radius:6px; }
QFrame#optimal_box { background:#0e2432; border:1px solid #1f6feb; border-radius:8px; }
QLabel#optimal_title { color:#58a6ff; font-size:11px; font-weight:bold; letter-spacing:1px; }
QLabel#optimal_value { color:#3fb950; font-size:13px; font-weight:bold; font-family:"Consolas",monospace; }
QStatusBar { background:#161b22; color:#6e7681; border-top:1px solid #21262d; font-size:10px; }